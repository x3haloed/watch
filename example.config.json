{
  "defaultModel": "openrouter:openrouter/owl-alpha",
  "restingModel": "openrouter:openrouter/owl-alpha",
  "ledgerPath": "ledger.md",
  "restAfterNoToolSoundings": 3,
  "estimatedTokenWarningThreshold": 200000,
  "memory": {
    "seedCrystals": {
      "enabled": false,
      "injectionEnabled": true,
      "commissioningEnabled": true,
      "creationPolicy": "candidate_first",
      "promotionPolicy": "judgment_only",
      "maxActiveBytes": 24000,
      "activeCountWarning": 8,
      "recoveryCliEnabled": true,
      "omissionExperimentsEnabled": false,
      "presentFitEnabled": true
    }
  },
  "game": {
    "controlUrl": "http://127.0.0.1:38473",
    "actionTimeoutMs": 60000
  },
  "scratchpad": {
    "enabled": true,
    "dir": "scratchpad",
    "agentFile": "AGENT.md",
    "userFile": "USER.md",
    "agentMaxChars": 2000,
    "userMaxChars": 2000
  },
  "streams": [
    {
      "kind": "web_api",
      "name": "usgs:earthquakes:all_hour",
      "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson",
      "intervalMs": 900000,
      "active": false,
      "waking": false
    },
    {
      "kind": "web_api",
      "name": "tinyplace:main",
      "url": "https://tinyplace.chadjkirby.workers.dev/canvas",
      "intervalMs": 5000,
      "active": true,
      "waking": false,
      "format": "tinyplace_canvas"
    },
    {
      "kind": "sse",
      "name": "tinygrove:stream",
      "url": "http://127.0.0.1:37373/stream?waking=true",
      "active": true,
      "waking": true
    },
    {
      "kind": "camera",
      "name": "camera:motion",
      "url": "ws://127.0.0.1:8765/",
      "mode": "stills",
      "fps": 2,
      "motionGate": true,
      "active": false,
      "waking": true,
      "maxBufferedChunks": 3
    },
    {
      "kind": "desktop_capture",
      "name": "desktop:capture",
      "fps": 3,
      "width": 1024,
      "height": 768,
      "waking": false,
      "active": false,
      "maxBufferedChunks": 3
    }
  ],
  "moltbook": {
    "enabled": false,
    "apiKeyEnv": "MOLTBOOK_API_KEY",
    "intervalMs": 300000,
    "subscribed": true,
    "waking": true,
    "maxItemsPerDelta": 10,
    "scopes": [
      {
        "type": "home"
      }
    ]
  },
  "minCffMs": 10000,
  "maxCffMs": 300000,
  "modelTimeoutMs": 120000,
  "models": {
    "openrouter:deepseek/deepseek-v4-flash": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "openrouter:openrouter/owl-alpha": {
      "provider": "openrouter",
      "model": "openrouter/owl-alpha",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "openrouter:xiaomi/mimo-v2.5": {
      "provider": "openrouter",
      "model": "xiaomi/mimo-v2.5",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    }
  },
  "discord": {
    "enabled": true,
    "tokenEnv": "DISCORD_BOT_TOKEN",
    "dmWhitelist": {
      "mode": "all",
      "userIds": []
    }
  }
}
