{
  "name": "watch",
  "version": "0.0.0",
  "description": "A continuous agent harness built on the AI SDK.",
  "bin": {
    "watch": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "desktop:dev": "electron apps/desktop-companion/main.cjs",
    "visualizer-studio": "python3 -m http.server 4488",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.78",
    "ai": "^7.0.153",
    "blessed": "^0.1.81",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
